{
  "name": "totalmod-monorepo",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @totalmod/demo-notes test:e2e",
    "local:up": "pnpm --filter @totalmod/demo-notes local:up",
    "local:down": "pnpm --filter @totalmod/demo-notes local:down",
    "local:logs": "pnpm --filter @totalmod/demo-notes local:logs",
    "evals": "pnpm dlx promptfoo@0.125.1 eval -c evals/interviewer.yaml",
    "build": "turbo run build --filter=./packages/*",
    "pack:smoke": "node scripts/smoke/pack-smoke.ts",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.5",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
