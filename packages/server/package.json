{
  "name": "@totalmod/server",
  "version": "0.3.0",
  "type": "module",
  "license": "(AGPL-3.0-only OR LicenseRef-totalmod-Commercial)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumanprime/totalmod.git",
    "directory": "packages/server"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./next": "./src/next.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "COMMERCIAL-LICENSE.md",
    "prompts"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./next": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"for (const f of ['LICENSE', 'COMMERCIAL-LICENSE.md']) require('fs').copyFileSync('../../' + f, f)\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@totalmod/core": "workspace:*",
    "@totalmod/telemetry": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
