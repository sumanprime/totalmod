{
  "name": "totalmod",
  "version": "0.3.0",
  "type": "module",
  "license": "(AGPL-3.0-only OR LicenseRef-totalmod-Commercial)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumanprime/totalmod.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "totalmod": "./src/bin.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "COMMERCIAL-LICENSE.md",
    "templates",
    "demo"
  ],
  "publishConfig": {
    "access": "public",
    "bin": {
      "totalmod": "./dist/bin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"for (const f of ['LICENSE', 'COMMERCIAL-LICENSE.md']) require('fs').copyFileSync('../../' + f, f)\" && node -e \"require('fs').cpSync('../../templates', 'templates', { recursive: true })\" && node scripts/bundle-demo.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@totalmod/core": "workspace:*",
    "@totalmod/telemetry": "workspace:*"
  }
}
